generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Guest {
  id             String   @id @default(cuid())
  name           String
  email          String
  phone          String
  hotel          String?
  dietary        String?
  plusOne        Boolean  @default(false)
  plusOneDetails String?
  createdAt      DateTime @default(now())
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model GalleryImage {
  id        String   @id @default(cuid())
  url       String
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
}