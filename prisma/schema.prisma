generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Guest {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String?
  plusOne     Boolean  @default(false)
  plusOneName String?
  dietary     String?
  message     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}